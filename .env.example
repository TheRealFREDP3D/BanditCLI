# Copy this file to .env and fill in your actual values
# The .env file should never be committed to version control

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================

# OpenAI API Configuration
# Required for AI mentor functionality
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model to use for AI interactions
# Common options: gpt-3.5-turbo, gpt-4, gpt-4-turbo
OPENAI_MODEL=gpt-3.5-turbo

# Alternative: Use local Ollama instance
# Uncomment and set to use a local Ollama model instead of OpenAI
# Requires Ollama installation: https://ollama.ai/
# Example models: ollama/llama3.2, ollama/mistral, ollama/codellama
# OPENAI_MODEL=ollama/llama3.2

# =============================================================================
# SSH CONNECTION CONFIGURATION
# =============================================================================

# Default SSH host for Bandit wargame
# Can be overridden in the application UI
DEFAULT_SSH_HOST=bandit.labs.overthewire.org

# Default SSH port (OverTheWire Bandit uses port 2220)
DEFAULT_SSH_PORT=2220

# SSH connection timeout in seconds
# Increase if you experience connection timeouts on slow networks
DEFAULT_SSH_TIMEOUT=10

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Enable debug mode (shows additional logging and error details)
# Set to True for development, False for production
DEBUG=False

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# INFO is recommended for normal use
LOG_LEVEL=INFO

# =============================================================================
# OPTIONAL ADVANCED SETTINGS
# =============================================================================

# Cache directory for command history and AI responses
# Defaults to user's home directory if not specified
# CACHE_DIR=/path/to/cache/directory

# Maximum number of cached commands to keep
# Helps with command history and suggestion features
# MAX_CACHE_SIZE=1000

# AI response temperature (0.0-2.0)
# Higher values make responses more creative, lower values more deterministic
# AI_TEMPERATURE=0.7

# Maximum AI response tokens
# Limits the length of AI responses to control costs
# AI_MAX_TOKENS=1000
